  {
    "title": "Death-Row Political Prisoner Barzou Rezaei Transferred to Ghezel Hesar Prison in Karaj",
    "link": "https://www.en-hrana.org/death-row-political-prisoner-barzou-rezaei-transferred-to-ghezel-hesar-prison-in-karaj/",
    "pubDate": "2026-10-08T09:28:05.000Z",
    "content": "<p class=\"w6asjq_TextBase _85PZeG_Text\" data-d-text-flow=\"\" data-d-component=\"text\"><span data-d-text-flow=\"word\" data-d-stream-word=\"\">According </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">HRANA, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">news </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">agency </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">of </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Human </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Rights </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Activists </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">in </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Iran, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Barzou </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Rezaei, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">a </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">prisoner </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">sentenced </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">death, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">has </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">been </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">transferred </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Ghezel </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Hesar </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Prison </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">in </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Karaj.</span></p>\n<p class=\"w6asjq_TextBase _85PZeG_Text\" data-d-text-flow=\"\" data-d-component=\"text\"><span data-d-text-flow=\"word\" data-d-stream-word=\"\">According </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">information </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">received </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">by </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">HRANA, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">on </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Wednesday, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">October </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">7, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">2026, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Rezaei </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">was </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">transferred </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">from </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Greater </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Tehran </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Prison </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Ghezel </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Hesar </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Prison </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">in </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Karaj </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">without </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">prior </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">notice. </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">The </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">reasons </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">for </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">his </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">transfer </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">remain </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">unknown.</span></p>\n<p class=\"w6asjq_TextBase _85PZeG_Text\" data-d-text-flow=\"\" data-d-component=\"text\"><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Mr. </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Rezaei </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">was </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">recently </span><span class=\"oIb9lq_Box\" data-d-auto-spacing=\"\" data-d-component=\"box\" data-d-direction=\"col\" data-d-inline=\"\" data-d-stream-inline=\"\"><span class=\"Wl_3jG_Trigger\" role=\"presentation\" data-d-component=\"popover-trigger\" data-d-inline=\"\" data-d-inline-text=\"\" aria-haspopup=\"dialog\" aria-expanded=\"false\" data-state=\"closed\"><span class=\"w6asjq_TextBase _85PZeG_Text\" data-d-text-flow=\"\" data-d-component=\"text\" data-d-inline=\"\" data-d-text-decoration=\"underline-dotted\"><strong><a href=\"https://www.en-hrana.org/january-2026-protests-barzou-rezaei-sentenced-to-death/\">sentenced</a></strong> <span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">death</span></span></span></span> <span data-d-text-flow=\"word\" data-d-stream-word=\"\">by </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Branch </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">23 </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">of </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Tehran </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Revolutionary </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Court </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">on </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">charge </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">of </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">“collaboration </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">with </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">hostile </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">governments.” </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">The </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">verdict </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">was </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">communicated </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">his </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">lawyer </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">following </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">its </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">issuance.</span></p>\n<p class=\"w6asjq_TextBase _85PZeG_Text\" data-d-text-flow=\"\" data-d-component=\"text\"><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Barzou </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Rezaei, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">a </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">resident </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">of </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Kermanshah, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">was </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">arrested </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">in </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">March </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">2026 </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">in </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">connection </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">with </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">nationwide </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">protests </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">of </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">January </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">2026. </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Following </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">his </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">arrest, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">he </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">was </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">transferred </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Greater </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Tehran </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Prison.</span></p>\n<p><strong>Background on January 2026 Protests:</strong></p>",
