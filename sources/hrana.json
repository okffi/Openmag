    "content": "<p class=\"w6asjq_TextBase _85PZeG_Text\" data-d-text-flow=\"\" data-d-component=\"text\"><span data-d-text-flow=\"word\" data-d-stream-word=\"\">According </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">HRANA, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">citing </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Kolbar News, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">today, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Thursday, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">October </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">8, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">2026, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">seven </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">citizens </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">were </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">arrested </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">in </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Saqqez.</span></p>\n<p class=\"w6asjq_TextBase _85PZeG_Text\" data-d-text-flow=\"\" data-d-component=\"text\"><span data-d-text-flow=\"word\" data-d-stream-word=\"\">The </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">individuals </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">have </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">been </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">identified </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">as </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Abdullah </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Amini, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Rahim </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Haghparast, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Seyed </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Mohammad </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Saleh </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Hosseini, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Mohammad </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Hakimpour, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Mostafa </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Ghaderi, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Khaled </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Rahimi, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">and </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Hossein </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Abdollahi, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">all </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">residents </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">of </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Saqqez.</span></p>\n<p class=\"w6asjq_TextBase _85PZeG_Text\" data-d-text-flow=\"\" data-d-component=\"text\"><span data-d-text-flow=\"word\" data-d-stream-word=\"\">According </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">report, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Ministry </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">of </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Intelligence </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">agents </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">simultaneously </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">arrested </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">seven </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">individuals </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">at </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">their </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">homes </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">in </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Saqqez </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">and </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">subsequently </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">transferred </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">them </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">an </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">undisclosed </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">location.</span></p>\n<p class=\"w6asjq_TextBase _85PZeG_Text\" data-d-text-flow=\"\" data-d-component=\"text\"><span data-d-text-flow=\"word\" data-d-stream-word=\"\">The </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">arrests </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">reportedly </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">involved </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">use </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">of </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">violence, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">with </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">agents </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">physically </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">assaulting </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">and </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">beating </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">individuals.</span></p>\n<p class=\"w6asjq_TextBase _85PZeG_Text\" data-d-text-flow=\"\" data-d-component=\"text\"><span data-d-text-flow=\"word\" data-d-stream-word=\"\">At </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">time </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">of </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">this </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">report, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">no </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">information </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">has </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">been </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">obtained </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">regarding </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">reasons </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">for </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">their </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">arrests </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">or </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">charges </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">brought </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">against </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">them.</span></p>",
