    "pubDate": "2026-10-08T11:16:54.000Z",
    "content": "<p class=\"w6asjq_TextBase _85PZeG_Text\" data-d-text-flow=\"\" data-d-component=\"text\"><span data-d-text-flow=\"word\" data-d-stream-word=\"\">According </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">HRANA, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">citing </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Kurdpa, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Faramarz </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Saedi </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">was </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">arrested </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">by </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">security </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">forces </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">on </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">a </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">street </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">in </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Dehgolan, Kurdistan province, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">on </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Tuesday, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">October </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">6, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">2026.</span></p>\n<p class=\"w6asjq_TextBase _85PZeG_Text\" data-d-text-flow=\"\" data-d-component=\"text\"><span data-d-text-flow=\"word\" data-d-stream-word=\"\">According </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">report, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Mr. </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Saedi </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">was </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">arrested </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">without </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">a </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">judicial </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">warrant </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">and </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">subjected </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">violence </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">during </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">his </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">arrest. </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">He </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">was </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">subsequently </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">transferred </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">to </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Ministry </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">of </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Intelligence’s </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">detention </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">facility </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">in </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">Dehgolan </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">for </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">interrogation.</span></p>\n<p class=\"w6asjq_TextBase _85PZeG_Text\" data-d-text-flow=\"\" data-d-component=\"text\"><span data-d-text-flow=\"word\" data-d-stream-word=\"\">At </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">time </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">of </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">this </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">report, </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">reasons </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">for </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">his </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">arrest </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">and </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">the </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">charges </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">against </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">him </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">remain </span><span data-d-text-flow=\"word\" data-d-stream-word=\"\">unknown.</span></p>",
